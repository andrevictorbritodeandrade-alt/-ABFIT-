rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: artifacts/{appId}/public/data/students
    // Document ID: {studentId}
    // Fields:
    //   - id: string (required) - Unique student ID
    //   - nome: string (required) - Student name
    //   - email: string (optional) - Student email
    //   - photoUrl: string (optional) - Base64 profile photo
    //   - workouts: list (optional) - Array of workout objects
    //   - workoutHistory: list (optional) - Array of history entries
    //   - periodization: map (optional) - Periodization details
    //   - analytics: map (optional) - Performance metrics
    //   - lastUpdateTimestamp: number (optional) - Last update time
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(studentId) {
      return isAuthenticated() && (request.auth.uid == studentId || request.auth.token.email == getStudentEmail(studentId));
    }

    function getStudentEmail(studentId) {
      return get(/databases/$(database)/documents/artifacts/abfit-d5bff/public/data/students/$(studentId)).data.email;
    }

    // Simplificação para o protótipo: Professor tem acesso total
    function isCoach() {
      return isAuthenticated() && (request.auth.token.email == "andrevictorbritodeandrade@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidStudent(data) {
      return data.nome is string && data.nome.size() > 0 && data.nome.size() < 100 &&
             (!('email' in data) || (data.email is string && data.email.size() < 100)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() < 2000000));
    }

    match /artifacts/{appId}/public/data/students/{studentId} {
      // Leitura: O próprio aluno ou o professor
      allow read: if isAuthenticated() && (request.auth.uid == studentId || isCoach());
      
      // Escrita: O próprio aluno (para atualizar histórico/foto) ou o professor (para prescrever)
      allow create, update: if isAuthenticated() && (request.auth.uid == studentId || isCoach()) && isValidStudent(request.resource.data);
      
      allow delete: if isCoach();
    }
  }
}
